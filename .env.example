# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development

# Platform API
API_PORT=3000
# Origin of the platform front end as seen by the browser (used for CSRF origin checks)
PLATFORM_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgres://webcove:webcove_dev_only@127.0.0.1:55432/webcove
TEST_DATABASE_URL=postgres://webcove:webcove_dev_only@127.0.0.1:55432/webcove_test
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Object storage (S3-compatible; SeaweedFS locally)
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=webcove-versions
S3_ACCESS_KEY=webcove
S3_SECRET_KEY=webcove_dev_only
