{
  "name": "web-cove",
  "private": true,
  "type": "module",
  "description": "Web Cove: Secure Web Assignment Hosting Platform (CAT404)",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel -r --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test": "vitest run",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "db:migrate": "pnpm --filter @webcove/api db:migrate",
    "db:seed:demo": "pnpm --filter @webcove/api db:seed:demo",
    "test:e2e": "playwright test tests/e2e",
    "fixtures:archives": "tsx scripts/generate-attack-zips.ts",
    "test:security": "playwright test tests/security",
    "fixtures:external": "tsx scripts/fetch-external-samples.ts",
    "test:compatibility": "playwright test tests/compatibility"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@webcove/zip-validator": "workspace:*",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
